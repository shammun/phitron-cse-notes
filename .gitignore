# Whitelist: only source code, the build kit and the generated site are published.
*
!*/
!*.c
!*.C
!*.cpp
!*.py
!.gitignore
!README.md
!docs/**
!_build/*.py
!_build/*.css
!_build/*.js
!_build/*.md
!_build/manifest.json
!_build/notes/*.json

# Never publish these, even if they contain code files
MinGW/
.vincent/
.vscode/
_build/cache/
_build/build_report.md
__pycache__/
